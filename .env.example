POSTGRES_DB=simplified_banking
POSTGRES_USER=simplified_banking
POSTGRES_PASSWORD=simplified_banking
POSTGRES_PORT=5432

RABBITMQ_USERNAME=simplified_banking
RABBITMQ_PASSWORD=simplified_banking
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Gatling must target a separately running, disposable load-test environment.
TRANSFER_LOAD_ENVIRONMENT=dedicated-load-test
TRANSFER_LOAD_BASE_URL=http://localhost:18080
TRANSFER_LOAD_RATE=10
TRANSFER_LOAD_DURATION_SECONDS=30
TRANSFER_LOAD_DESTINATIONS=20
TRANSFER_LOAD_DATABASE_URL=jdbc:postgresql://localhost:5433/simplified_banking_load
TRANSFER_LOAD_DATABASE_USERNAME=simplified_banking_load
TRANSFER_LOAD_DATABASE_PASSWORD=simplified_banking_load
